APP_NAME="FitCrew Challenge"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://fitcrew.test
APP_TIMEZONE=America/New_York
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fitcrew
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_TIMEZONE=+00:00

# Phase 2A1 migration safety allowlists. Production migration policy is governed separately.
MIGRATION_ALLOWED_ENVIRONMENTS=local
MIGRATION_ALLOWED_HOSTS=127.0.0.1,localhost
MIGRATION_ALLOWED_DATABASES=fitcrew

SESSION_NAME=fitcrew_session
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# Phase 2A3 session policy. Production must set explicit values before Google auth proof.
SESSION_IDLE_SECONDS=
SESSION_ABSOLUTE_SECONDS=

# Provider-neutral protected auth-transaction secret.
# Real value belongs only in .env / environment and must never be committed.
AUTH_TRANSACTION_SECRET_KEY_B64=

# Provider-neutral auth transaction lifetime. Provider implementations remain separately governed.
AUTH_TRANSACTION_TTL_SECONDS=600

# Phase 2A3 Google authentication. Authentication-only; separate from Google Health.
GOOGLE_AUTH_ENABLED=false
GOOGLE_AUTH_CLIENT_ID=


# Phase 2A4 Microsoft authentication — Authorization Code + OIDC + PKCE.
# Client secret is environment-only. Redirect URI must exactly match the registered web callback.
MICROSOFT_AUTH_ENABLED=false
# Governance-controlled ordinary consumer visibility. The provider runtime and its
# production-proven implementation remain available when this is false.
MICROSOFT_AUTH_CONSUMER_VISIBLE=false
MICROSOFT_AUTH_CLIENT_ID=
MICROSOFT_AUTH_CLIENT_SECRET=
MICROSOFT_AUTH_REDIRECT_URI=http://fitcrew.test/auth/microsoft/callback.php

# Controlled Microsoft prelaunch gate. New Microsoft identities are allowed only when their
# validated tenant ID + object ID pair is listed here. Format: tid:oid,tid:oid
# This is temporary proof control; email is never used as Microsoft identity truth or gate truth.
PRELAUNCH_MICROSOFT_ALLOWED_IDENTITIES=

# Controlled prelaunch proof gate. New Google identities are denied unless their validated,
# verified provider email is listed in the environment-only allowlist. Existing linked identities
# may return regardless of this allowlist. This is a creation gate, never identity truth.
PRELAUNCH_AUTH_PROOF_MODE=true
PRELAUNCH_AUTH_ALLOWED_EMAILS=

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@fitcrewchallenge.com
MAIL_FROM_NAME="FitCrew Challenge"

# Placeholders only. Google Health OAuth implementation is not part of Phase 1 skeleton.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://fitcrew.test/health/google/callback

# Future provider flags. These are parked and not implemented in Phase 1.
APPLE_HEALTH_ENABLED=false
HEALTH_CONNECT_ENABLED=false
CSV_IMPORT_ENABLED=false

LOG_CHANNEL=file
LOG_LEVEL=debug
STORAGE_PATH=storage
